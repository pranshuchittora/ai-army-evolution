# ============================================================
#  AI 军团进化论 · 环境变量模板
#  用法：cp .env.example .env  然后按需填写自己的值。
#  .env 已被 .gitignore 忽略，绝不会进版本库。
# ============================================================

# ---- 站点公开配置（会进入前端 bundle，NEXT_PUBLIC_ 前缀）----

# 站点对外地址（用于 canonical / sitemap / OG）。本地开发可留默认。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 站点名称
NEXT_PUBLIC_SITE_NAME=AI 军团进化论

# 百度统计 ID（hm.js?<id> 里的 id）。留空则不加载任何统计脚本。
NEXT_PUBLIC_BAIDU_ANALYTICS_ID=

# ---- 社群入口（留空则首页不展示对应入口）----
# 微信群二维码图片（放 public/ 下）
NEXT_PUBLIC_COMMUNITY_QR=
# 二维码说明文案
NEXT_PUBLIC_COMMUNITY_QR_NOTE=群二维码会定期更新，扫码即可加入
# 群满/过期时引导添加的个人微信号
NEXT_PUBLIC_COMMUNITY_WECHAT=
