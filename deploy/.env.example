# ============================================================
#  部署凭据模板（敏感）——仅本地使用，绝不进版本库
#  用法：cp deploy/.env.example deploy/.env  然后填入真实值。
#  publish.sh / deploy 相关脚本会自动加载 deploy/.env。
# ============================================================

# ---- 目标服务器 ----
DEPLOY_SSH_KEY=/path/to/your_key.pem        # SSH 私钥路径
DEPLOY_SSH_USER=ubuntu                       # SSH 用户名
DEPLOY_SSH_HOST=203.0.113.10                 # 服务器 IP / 主机名
DEPLOY_REMOTE_DIR=/srv/ai-army-evolution     # 服务器上的源码目录

# ---- 应用容器 ----
APP_NAME=ai-army-evolution
APP_HOST_PORT=8090                           # 宿主机回环端口（nginx 反代目标）
APP_CONTAINER_PORT=3000

# ---- 站点 ----
SITE_DOMAIN=example.com                      # 你的域名
SITE_URL=https://example.com

# ---- 反向代理容器（若用 Docker 化 nginx；不用则忽略）----
NGINX_CONTAINER=my-nginx                     # 你的 nginx 容器名（裸机 nginx 留空）
NGINX_CONF_DIR=/etc/nginx/conf.d             # 容器内 / 宿主机挂载的 nginx 配置目录
ACME_WEBROOT=/var/www/html                   # certbot webroot 路径
ACME_EMAIL=you@example.com                   # Let's Encrypt 联系邮箱

# ---- git 提交署名（publish.sh 自动提交时用）----
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com
